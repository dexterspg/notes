# .dockerignore file
# 
# This file works similar to .gitignore but for Docker build context
# Files and directories listed here will be excluded from the build context
# sent to the Docker daemon, making builds faster and more secure

# Maven build artifacts
target/
*.jar
*.war

# Git files (not needed in Docker image)
.git/
.gitignore

# Documentation files (not needed in runtime image)
*.md
README*
docs/

# IDE files
.idea/
.vscode/
*.iml
*.iws
*.ipr
.settings/
.project
.classpath

# Maven wrapper (we use Maven from the base image)
.mvn/
mvnw
mvnw.cmd

# Docker files (don't copy into the image)
Dockerfile*
docker-compose*.yml
.dockerignore

# OS generated files
.DS_Store
Thumbs.db

# Log files
*.log

# Temporary files
*.tmp
*.temp
*~

# Node modules (if you have any frontend assets)
node_modules/
npm-debug.log*

# Environment files (may contain sensitive information)
.env
.env.local
.env.*.local