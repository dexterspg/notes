<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" 
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 
         https://maven.apache.org/xsd/maven-4.0.0.xsd">
    
    <!-- Maven model version - always 4.0.0 for Maven 2+ -->
    <modelVersion>4.0.0</modelVersion>
    
    <!-- 
        Spring Boot Parent POM - provides dependency management and default configurations
        This eliminates the need to specify versions for most Spring dependencies
    -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.2.0</version>
        <relativePath/> <!-- lookup parent from repository -->
    </parent>

    <!-- Project coordinates - uniquely identify this project -->
    <groupId>com.example</groupId>
    <artifactId>docker-spring-boot-demo</artifactId>
    <version>1.0.0</version>
    <name>Docker Spring Boot Demo</name>
    <description>A simple Spring Boot application demonstrating Docker containerization</description>

    <!-- Java version specification -->
    <properties>
        <java.version>17</java.version>
    </properties>

    <dependencies>
        <!-- 
            Spring Boot Web Starter - includes:
            - Spring MVC for web applications
            - Embedded Tomcat server
            - Auto-configuration for web development
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- 
            Spring Boot Actuator - provides production-ready features:
            - Health checks
            - Metrics
            - Application information endpoints
            Useful for monitoring containerized applications
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <!-- 
            Spring Boot Test Starter - includes testing dependencies:
            - JUnit 5
            - Mockito
            - Spring Test
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- 
                Spring Boot Maven Plugin - provides several goals:
                - spring-boot:run - run the application
                - spring-boot:build-image - create Docker image (Docker buildpacks)
                - spring-boot:repackage - create executable JAR
            -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
        
        <!-- 
            Final name of the built JAR file
            This will create docker-spring-boot-demo-1.0.0.jar
        -->
        <finalName>${project.artifactId}-${project.version}</finalName>
    </build>
</project>